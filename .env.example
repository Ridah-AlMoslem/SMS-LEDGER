# Copy to .env.local (web) and .env (api). Never commit the filled-in version.

# --- Database -------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled connection (port 6543) for serverless; the direct connection
# (5432) is for drizzle-kit migrations only.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- Supabase client ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest ---------------------------------------------------------------
# Shared with the iPhone Shortcut. Sign the request body:
#   X-Signature: hex(HMAC-SHA256(body, INGEST_SECRET))
# Generate with: openssl rand -hex 32
INGEST_SECRET=

# Guards /api/parse-tick so only pg_cron can drive the parser.
CRON_SECRET=

# --- LLM fallback (deferred past v1) --------------------------------------
# Unknown message shapes park in the review queue for now. Set this only when
# the manual workbench stops being good enough.
# GEMINI_API_KEY=
