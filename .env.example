# Template only. The real files already exist and are gitignored:
#
#   web/.env.local    web service
#   api/.env          parser service
#
# This file is committed, so never put a real value in it.

# --- Needed now ------------------------------------------------------------
# Supabase → "Connect" → Connection string → URI.
# 6543 = transaction pooler, for the app.        → DATABASE_URL (both files)
# 5432 = direct/session, for migrations.         → DIRECT_URL (web only)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres

# Generated per-install: openssl rand -hex 32
INGEST_SECRET=
CRON_SECRET=

# --- Needed later (milestone 8: auth) --------------------------------------
# Use the new key format. Legacy anon / service_role JWTs are deprecated by
# end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Deferred past v1 ------------------------------------------------------
# Unknown message shapes park in the review queue instead.
# GEMINI_API_KEY=
