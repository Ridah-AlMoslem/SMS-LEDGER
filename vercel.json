{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "PARSER_URL" }
      ]
    },
    "api": {
      "root": "api/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/ingest", "destination": { "service": "api" } },
    { "source": "/api/parse-tick", "destination": { "service": "api" } },
    { "source": "/api/templates/(.*)", "destination": { "service": "api" } },
    { "source": "/api/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
