# Template only. The real files already exist and are gitignored:
#
#   web/.env.local    web service
#   api/.env          parser service
#
# This file is committed, so never put a real value in it.

# --- Needed now ------------------------------------------------------------
# Supabase → "Connect" → Connection string → URI.
#
#   Transaction pooler, 6543 → DATABASE_URL  (both files)
#   Session pooler,     5432 → DIRECT_URL    (web only, migrations)
#
# Use the SESSION POOLER for DIRECT_URL, not "Direct connection".
# db.<ref>.supabase.co is IPv6-only and hangs on IPv4-only networks instead of
# failing. Both strings share the pooler host and the postgres.<ref> username;
# only the port differs.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Generated per-install: openssl rand -hex 32
INGEST_SECRET=
CRON_SECRET=

# --- Needed later (milestone 8: auth) --------------------------------------
# Use the new key format. Legacy anon / service_role JWTs are deprecated by
# end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Deferred past v1 ------------------------------------------------------
# Unknown message shapes park in the review queue instead.
# GEMINI_API_KEY=
